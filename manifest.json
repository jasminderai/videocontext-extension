{
  "manifest_version": 3,
  "name": "VideoContext App",
  "version": "0.3.3",
  "description": "Turn screen recordings into AI-ready context. Capture, extract the best frames, paste them into any LLM. videocontext.app",
  "author": "Jasminder Pal Singh",
  "homepage_url": "https://videocontext.app",

  "action": {
    "default_title": "VideoContext App — toggle recorder",
    "default_icon": {
      "16": "assets/logo.png",
      "48": "assets/logo.png",
      "128": "assets/logo.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "permissions": [
    "desktopCapture",
    "clipboardWrite",
    "scripting",
    "activeTab"
  ],

  "icons": {
    "16": "assets/logo.png",
    "48": "assets/logo.png",
    "128": "assets/logo.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["assets/logo.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
